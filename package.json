{
  "name": "@michaelabrt/clarte",
  "version": "1.0.6",
  "description": "The starting point your agent is missing. Builds dependency graphs, predicts edit targets and steers the agent before it starts exploring.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "clarte": "dist/index.js",
    "clarte-mcp": "dist/mcp-server.js"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-wasm.js",
    "dev": "tsup --watch --onSuccess 'node scripts/copy-wasm.js'",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:evals": "REAL_PROJECT_EVAL=1 vitest run src/__tests__/evals/",
    "test:watch": "vitest",
    "bench": "vitest bench src/__tests__/bench/",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "prepublishOnly": "bun run build",
    "prepare": "husky"
  },
  "keywords": [
    "static-analysis",
    "dependency-graph",
    "architecture-analysis",
    "code-intelligence",
    "graph-analysis",
    "change-coupling",
    "developer-tools",
    "cli",
    "typescript",
    "code-analysis",
    "claude-code",
    "cursor",
    "copilot",
    "windsurf",
    "cline",
    "opencode",
    "ai-tools"
  ],
  "author": "Michael Aboukrat",
  "license": "FSL-1.1-MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelabrt/clarte.git"
  },
  "homepage": "https://github.com/michaelabrt/clarte#readme",
  "bugs": {
    "url": "https://github.com/michaelabrt/clarte/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "logo.svg"
  ],
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.6.0",
    "tinyglobby": "^0.2.12",
    "web-tree-sitter": "^0.26.5"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.4.0",
    "better-sqlite3": "^12.8.0",
    "sql.js": "^1.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/git": "^10.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vscode/tree-sitter-wasm": "^0.3.0",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.0",
    "tsup": "^8.4.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.18"
  }
}
