{
  "name": "clarte",
  "version": "1.0.0",
  "description": "Architecture intelligence engine for AI coding agents.",
  "type": "module",
  "bin": {
    "clarte": "dist/index.js",
    "clarte-mcp": "dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-wasm.js",
    "dev": "tsup --watch --onSuccess 'node scripts/copy-wasm.js'",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "static-analysis",
    "dependency-graph",
    "architecture-analysis",
    "code-intelligence",
    "graph-analysis",
    "change-coupling",
    "developer-tools",
    "cli",
    "typescript",
    "code-analysis",
    "claude-code",
    "cursor",
    "copilot",
    "windsurf",
    "cline",
    "aider",
    "opencode",
    "ai-tools"
  ],
  "author": "Michael Aboukrat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelabrt/clarte.git"
  },
  "homepage": "https://github.com/michaelabrt/clarte#readme",
  "bugs": {
    "url": "https://github.com/michaelabrt/clarte/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "logo.svg"
  ],
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.6.0",
    "tinyglobby": "^0.2.12",
    "web-tree-sitter": "^0.26.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/git": "^10.0.0",
    "@types/node": "^22.0.0",
    "@vscode/tree-sitter-wasm": "^0.3.0",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
