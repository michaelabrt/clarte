{
  "name": "clarte",
  "version": "1.0.0",
  "description": "Static analysis engine that generates context files for AI coding tools.",
  "type": "module",
  "bin": {
    "clarte": "dist/index.js",
    "clarte-mcp": "dist/mcp-server.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "static-analysis",
    "dependency-graph",
    "developer-tools",
    "cli",
    "typescript",
    "context-generation",
    "code-analysis",
    "claude-code",
    "cursor",
    "copilot",
    "windsurf",
    "cline",
    "aider",
    "opencode",
    "mcp",
    "ai-tools"
  ],
  "author": "Michael Aboukrat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelabrt/clarte.git"
  },
  "homepage": "https://github.com/michaelabrt/clarte#readme",
  "bugs": {
    "url": "https://github.com/michaelabrt/clarte/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.6.0",
    "tinyglobby": "^0.2.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/git": "^10.0.0",
    "@types/node": "^22.0.0",
    "semantic-release": "^25.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
